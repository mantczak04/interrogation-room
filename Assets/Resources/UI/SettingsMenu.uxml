<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/Theme.uss" />
    <ui:Style src="project://database/Assets/UI/SettingsMenu.uss" />

    <ui:VisualElement name="settings-scrim" class="settings-scrim ui-font no-hover-sound">
        <ui:VisualElement name="settings-sheet" class="settings-sheet surface-paper document-font">
            <ui:Label name="title" class="settings-title stamp-font" text="USTAWIENIA" />
            <ui:VisualElement class="settings-rule" />

            <ui:VisualElement class="settings-tabs">
                <ui:Button name="general-tab-button" class="settings-tab stamp-font is-selected" text="OGÓLNE" />
                <ui:Button name="controls-tab-button" class="settings-tab stamp-font" text="STEROWANIE" />
                <ui:Button name="sound-tab-button" class="settings-tab stamp-font" text="DŹWIĘK" />
            </ui:VisualElement>

            <ui:VisualElement class="settings-sections">
                <ui:VisualElement name="general-section" class="settings-section is-selected">
                    <ui:VisualElement class="settings-group">
                        <ui:VisualElement class="settings-row">
                            <ui:Label name="sensitivity-caption" class="settings-caption" text="Czułość myszy" />
                            <ui:Label name="sensitivity-value" class="settings-value" text="1.0" />
                        </ui:VisualElement>
                        <ui:Slider name="sensitivity-slider" class="settings-slider" low-value="0.1" high-value="5" />
                    </ui:VisualElement>

                    <ui:VisualElement class="settings-group">
                        <ui:Label name="language-caption" class="settings-caption" text="Język" />
                        <ui:VisualElement class="settings-language-row">
                            <ui:Button name="polish-button" class="btn btn--paper" text="Polski" />
                            <ui:Button name="english-button" class="btn btn--paper" text="Angielski" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="controls-section" class="settings-section">
                    <ui:Label name="controls-hint" class="settings-hint" text="Wybierz akcję, a następnie naciśnij nowy klawisz lub przycisk myszy. Esc anuluje zmianę." />
                    <ui:VisualElement name="input-bindings-list" class="input-bindings-list" />
                    <ui:Button name="reset-all-bindings-button" class="btn btn--paper settings-compact-action" text="Przywróć domyślne sterowanie" />
                    <ui:Label name="input-binding-status" class="settings-hint input-binding-status" text="" />
                </ui:VisualElement>

                <ui:VisualElement name="sound-section" class="settings-section">
                    <ui:VisualElement class="settings-group">
                        <ui:VisualElement class="settings-row">
                            <ui:Label name="input-device-caption" class="settings-caption" text="Urządzenie wejściowe" />
                            <ui:Button name="refresh-voice-devices-button" class="btn btn--paper settings-small-button" text="Odśwież" />
                        </ui:VisualElement>
                        <ui:DropdownField name="input-device-dropdown" class="dropdown settings-dropdown" />
                        <ui:Label name="input-device-status" class="settings-hint settings-device-status" text="" />
                    </ui:VisualElement>

                    <ui:VisualElement class="settings-group">
                        <ui:VisualElement class="settings-row">
                            <ui:Label name="microphone-caption" class="settings-caption" text="Twój mikrofon" />
                            <ui:Label name="microphone-level-value" class="settings-value" text="100%" />
                        </ui:VisualElement>
                        <ui:Slider name="microphone-level-slider" class="settings-slider" low-value="0" high-value="200" />
                        <ui:Label name="microphone-state" class="settings-voice-state" text="MIKROFON WŁĄCZONY" />
                        <ui:VisualElement class="settings-voice-actions">
                            <ui:Button name="microphone-mute-button" class="btn btn--paper" text="Wycisz mikrofon" />
                            <ui:Button name="microphone-test-button" class="btn btn--paper" text="Odsłuch mikrofonu" />
                        </ui:VisualElement>
                        <ui:Label name="microphone-test-status" class="settings-hint settings-voice-hint" text="" />
                    </ui:VisualElement>

                    <ui:VisualElement class="settings-group settings-group--participants">
                        <ui:Label name="participant-volume-caption" class="settings-caption" text="Głośność rozmówców" />
                        <ui:ScrollView name="voice-participant-list" class="voice-participant-list" mode="Vertical" horizontal-scroller-visibility="Hidden" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="settings-footer">
                <ui:Button name="back-button" class="btn btn--ink settings-action" text="Wróć do menu" />
                <ui:Button name="leave-button" class="btn btn--destructive settings-action" text="Opuść Rundę" />
            </ui:VisualElement>

            <ui:VisualElement name="input-rebind-blocker" class="settings-rebind-blocker">
                <ui:Label name="input-rebind-blocker-label" class="settings-rebind-blocker-label" text="Naciśnij nowe wejście. Esc anuluje zmianę." />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
