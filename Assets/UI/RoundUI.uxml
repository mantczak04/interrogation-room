<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/RoundUI.uss" />
    <ui:VisualElement name="round-ui-root" class="round-ui">
        <ui:VisualElement name="lobby-panel" class="lobby-screen">
            <ui:VisualElement class="screen-shade lobby-screen-shade" />
            <ui:VisualElement class="lobby-wash lobby-wash--left" />
            <ui:VisualElement class="lobby-wash lobby-wash--right" />
            <ui:VisualElement class="lobby-layout">
                <ui:VisualElement name="lobby-settings-panel" class="lobby-settings-panel stamp-font" style="display: none;">
                    <ui:Label text="GOSPODARZ GRY" class="kicker stamp-font lobby-side-kicker" />
                    <ui:Label text="USTAWIENIA" class="lobby-side-title stamp-font" />
                    <ui:VisualElement class="rule lobby-side-rule" />
                    <ui:Label text="LIMIT RUNDY" class="lobby-round-limit-title stamp-font" />
                    <ui:VisualElement class="lobby-round-limit-options">
                        <ui:Button name="round-limit-5-button" text="5 MIN" class="btn btn--quiet lobby-round-limit-button" />
                        <ui:Button name="round-limit-10-button" text="10 MIN" class="btn btn--quiet lobby-round-limit-button" />
                        <ui:Button name="round-limit-15-button" text="15 MIN" class="btn btn--quiet lobby-round-limit-button" />
                        <ui:Button name="round-limit-20-button" text="20 MIN" class="btn btn--quiet lobby-round-limit-button lobby-round-limit-button--last" />
                    </ui:VisualElement>
                    <ui:VisualElement name="developer-role-section" class="developer-role-section" style="display: none;">
                        <ui:Label text="ROLA TESTOWA" class="lobby-round-limit-title stamp-font" />
                        <ui:VisualElement class="developer-role-options">
                            <ui:Button name="developer-role-innocent-button" text="NIEWINNY" class="btn btn--quiet developer-role-button" />
                            <ui:Button name="developer-role-guilty-button" text="WINNY" class="btn btn--quiet developer-role-button" />
                            <ui:Button name="developer-role-detective-button" text="DETEKTYW" class="btn btn--quiet developer-role-button developer-role-button--last" />
                        </ui:VisualElement>
                        <ui:Label text="Runda rozpocznie się od Przygotowania i pokaże właściwy prywatny widok." class="developer-role-summary" />
                    </ui:VisualElement>
                    <ui:VisualElement class="character-selector character-selector--legacy">
                        <ui:Button name="legacy-previous-character-button" text="‹" class="character-arrow" focusable="false" />
                        <ui:Label name="legacy-character-name-label" text="Małpa" class="character-name stamp-font" />
                        <ui:Button name="legacy-next-character-button" text="›" class="character-arrow" focusable="false" />
                    </ui:VisualElement>
                    <ui:Toggle name="secret-objective-toggle" label="Włącz Sekretny Cel" value="true" class="lobby-toggle" />
                    <ui:Label name="secret-objective-summary" text="Sekretny Cel jest dostępny od 5 graczy." class="lobby-toggle-summary" />
                </ui:VisualElement>
                <ui:VisualElement name="lobby-host-actions" class="lobby-host-actions stamp-font">
                    <ui:Button name="invite-button" text="Zaproś znajomych" class="btn stamp-font lobby-action" />
                    <ui:VisualElement name="invite-friend-panel" class="lobby-invite-panel" style="display: none;">
                        <ui:Label text="ZNAJOMI STEAM ONLINE" class="lobby-invite-heading stamp-font" />
                        <ui:ScrollView name="invite-friend-list" class="lobby-invite-list" mode="Vertical" horizontal-scroller-visibility="Hidden" />
                        <ui:Label name="invite-friend-empty" text="Brak znajomych Steam online." class="lobby-invite-empty" />
                        <ui:Label name="invite-friend-status" class="lobby-invite-status" style="display: none;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="start-button-hover-area" class="lobby-start-hover-area">
                        <ui:Button name="start-button" text="Start Rundy" class="btn lobby-start" />
                        <ui:Label name="start-button-hover-info" text="Wszyscy gracze muszą być gotowi." class="lobby-start-hover-info" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="lobby-help-label" text="Rundę można rozpocząć dla 3–8 graczy." class="lobby-help" />
                </ui:VisualElement>
                <ui:VisualElement class="lobby-stage">
                    <ui:Label name="lobby-roster-count" text="Gracze w lobby: 0/8" class="lobby-stage-count stamp-font" />
                    <ui:VisualElement name="developer-lineup-preview-section" class="developer-lineup-preview stamp-font" style="display: none;">
                        <ui:Label name="developer-dummy-count-label" text="MANEKINY: 0" class="developer-dummy-count" />
                        <ui:Button name="developer-dummy-remove-button" text="−" class="btn btn--quiet developer-dummy-step" />
                        <ui:Button name="developer-dummy-add-button" text="+" class="btn btn--quiet developer-dummy-step" />
                        <ui:Button name="developer-dummy-five-button" text="5 GRACZY" class="btn btn--quiet developer-dummy-target" />
                        <ui:Button name="developer-dummy-eight-button" text="8 GRACZY" class="btn btn--quiet developer-dummy-target" />
                        <ui:Button name="developer-dummy-clear-button" text="WYCZYŚĆ" class="btn btn--quiet developer-dummy-clear" />
                    </ui:VisualElement>
                    <ui:Label name="lobby-player-list-empty" text="Oczekiwanie na graczy…" class="lobby-player-list-empty" />
                    <ui:VisualElement name="lobby-lineup-viewport" class="lobby-lineup-viewport">
                        <ui:Image name="lobby-lineup-preview" class="lobby-lineup-preview" scale-mode="ScaleToFit" picking-mode="Ignore" />
                        <ui:VisualElement name="lobby-player-lineup" class="lobby-player-lineup" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="character-selector preview-character-selector">
                        <ui:Button name="previous-character-button" text="‹" class="character-arrow" focusable="false" />
                        <ui:Label name="character-name-label" text="Małpa" class="character-name stamp-font" />
                        <ui:Button name="next-character-button" text="›" class="character-arrow" focusable="false" />
                    </ui:VisualElement>
                    <ui:Button name="lobby-ready-button" text="Gotowy" class="btn lobby-ready-button" />
                    <ui:Label text="Wygląd postaci nie zdradza roli." class="preview-caption" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="lobby-settings-toggle-button" text="USTAWIENIA LOBBY" class="btn btn--quiet lobby-settings-toggle stamp-font" />
            <ui:Button name="lobby-back-button" class="lobby-back" text="Wyjdź z lobby" focusable="false" />
        </ui:VisualElement>

        <ui:VisualElement name="preparation-panel" class="full-screen-panel preparation-screen">
            <ui:VisualElement class="screen-shade" />
            <ui:VisualElement class="paper-shadow" />
            <ui:VisualElement class="preparation-document paper-document">
                <ui:VisualElement class="document-header">
                    <ui:VisualElement>
                        <ui:Label text="AKTA RUNDY" class="document-kicker stamp-font" />
                        <ui:Label text="Przygotowanie" class="title stamp-font" />
                    </ui:VisualElement>
                    <ui:Label name="preparation-timer-label" class="preparation-timer document-font" />
                </ui:VisualElement>
                <ui:ScrollView name="preparation-scroll" class="preparation-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden">
                    <ui:Label name="role-label" class="role-stamp" />
                    <ui:Label text="Przestępstwo" class="section-title paper-section-title stamp-font" />
                    <ui:Label name="crime-label" class="body-text document-font" />
                    <ui:VisualElement name="alibi-section">
                        <ui:Label text="Twoje Alibi" class="section-title paper-section-title stamp-font" />
                        <ui:Label name="alibi-label" class="alibi document-font" />
                    </ui:VisualElement>
                    <ui:Label name="preparation-instruction-label" class="preparation-instruction document-font" />
                </ui:ScrollView>
                <ui:VisualElement class="preparation-footer">
                    <ui:Label name="ready-count-label" class="ready-count" />
                    <ui:Button name="ready-button" text="Gotowy" class="btn ready-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="round-hud" class="hud no-hover-sound">
            <ui:Label name="timer-label" class="timer document-font" />
            <ui:VisualElement class="hud-card role-card">
                <ui:Label name="hud-role-label" class="hud-role" />
                <ui:Label name="hud-crime-label" class="hud-crime" />
            </ui:VisualElement>
            <ui:VisualElement name="private-panel" class="hud-card private-card">
                <ui:VisualElement class="private-header">
                    <ui:Label name="private-title-label" class="private-title" />
                    <ui:Button name="private-toggle-button" text="Zwiń [I]" class="btn btn--quiet panel-toggle" />
                </ui:VisualElement>
                <ui:ScrollView name="private-content" class="private-content">
                    <ui:Label name="private-motive-label" class="private-motive" />
                    <ui:Label name="private-step-label" class="private-step" />
                    <ui:Label name="private-location-label" class="private-location" />
                    <ui:Label name="private-progress-label" class="private-progress document-font" />
                    <ui:Label name="private-label" class="private-text" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="result-panel" class="full-screen-panel result-screen">
            <ui:VisualElement class="screen-shade" />
            <ui:VisualElement class="result-card dossier">
                <ui:Label text="KONIEC RUNDY" class="document-kicker stamp-font" />
                <ui:Label name="result-verdict-label" class="result-verdict stamp-font" />
                <ui:Label name="result-reason-label" class="result-reason" />
                <ui:VisualElement class="document-rule" />
                <ui:ScrollView name="result-scroll" class="result-scroll">
                    <ui:Label name="result-label" class="result document-font" />
                </ui:ScrollView>
                <ui:Button name="return-to-lobby-button" text="Wróć do lobby" class="btn result-action" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="rejection-label" class="toast rejection" />
    </ui:VisualElement>
</ui:UXML>
