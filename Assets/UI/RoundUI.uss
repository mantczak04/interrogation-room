/* Tokens, fonts and shared component classes live in Theme.uss. */
@import url("project://database/Assets/UI/Theme.uss");

.round-ui {
    flex-grow: 1;
    color: var(--text-hi);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Lato-Regular.ttf");
}

.full-screen-panel,
.lobby-screen,
.hud,
.screen-shade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.lobby-screen {
    background-image: url("project://database/Assets/Scenes/MainMenu/5d006397-6eb9-4f3f-ba4e-1b24d9f4b3ed.png");
    -unity-background-scale-mode: scale-and-crop;
}

.screen-shade {
    background-color: rgba(5, 7, 10, 0.68);
}

/*
 * The lobby borrows the main menu's grammar wholesale: type set straight on
 * the art, no framed cards. Each side column stands on a floor-to-ceiling
 * wash — the same device as .menu-wash — so the text stays readable without
 * boxing it in.
 */
.lobby-wash {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 30%;
    /* A baked gradient, not a flat block: a solid wash left a hard vertical
       seam across the key art. The right wash reuses the texture mirrored. */
    background-image: url("project://database/Assets/UI/Sprites/LobbyWashGradient.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.lobby-wash--left { left: 0; }

.lobby-wash--right {
    right: 0;
    scale: -1 1;
}

/* Positioning context only; the three parts place themselves. */
.lobby-layout {
    position: absolute;
    left: 5%;
    right: 5%;
    top: 0;
    bottom: 0;
}

.dossier {
    background-color: rgba(20, 24, 27, 0.97);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--brass);
    border-right-color: var(--brass);
    border-top-color: var(--brass);
    border-bottom-color: var(--brass);
    border-radius: 2px;
}

/*
 * The lobby was a dead end: once inside, the only way back to the main menu
 * was Esc into the settings sheet. The back control sits outside the dossier,
 * in the corner where a player already looks for it, so it never competes
 * with Start Rundy.
 */
.lobby-back {
    position: absolute;
    left: 3%;
    top: 4%;
    height: 44px;
    flex-direction: row;
    align-items: center;
    padding: 0 18px 0 12px;
    margin: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
}

/* Draw the arrow instead of using a font glyph, so font ascenders and
 * baselines cannot push it off the button's vertical center. */
.lobby-back-glyph {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
    margin-right: 16px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-right-color: var(--text-hi);
    border-bottom-color: var(--text-hi);
    rotate: 135deg;
    translate: 0 0.5px;
}

.lobby-back-text {
    /* Same stamp face as every other lobby header; Lato here read as a
       different app. */
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Staatliches-Regular.ttf");
    height: 44px;
    font-size: 20px;
    color: var(--text-hi);
    letter-spacing: 2px;
    padding: 0;
    -unity-text-align: middle-center;
}

.lobby-back:hover,
.lobby-back:hover:enabled {
    background-color: rgba(0, 0, 0, 0);
}

.lobby-back:hover .lobby-back-glyph,
.lobby-back:hover .lobby-back-text {
    color: var(--amber);
}

.lobby-back:hover .lobby-back-glyph {
    border-right-color: var(--amber);
    border-bottom-color: var(--amber);
}

.lobby-back:active .lobby-back-glyph,
.lobby-back:active .lobby-back-text {
    color: var(--amber-dim);
}

.lobby-back:active .lobby-back-glyph {
    border-right-color: var(--amber-dim);
    border-bottom-color: var(--amber-dim);
}

.lobby-back:focus,
.lobby-back:focus:enabled {
    background-color: rgba(0, 0, 0, 0);
}

.lobby-kicker,
.document-kicker {
    font-size: 15px;
    color: var(--amber);
    letter-spacing: 3px;
    margin-bottom: 16px;
}

.document-rule {
    height: 1px;
    background-color: var(--brass);
    margin-bottom: 16px;
}

.section-title {
    font-size: 15px;
    color: var(--amber);
    letter-spacing: 2px;
    margin-top: 8px;
    margin-bottom: 8px;
}

/*
 * One brass-framed field with the name centred in it, rather than a name
 * flanked by two grey buttons.
 *
 * The arrows previously inherited .button, which overrode only margin-top and
 * left Unity's default 2px margin on the other three sides — so each arrow sat
 * in a box that was off-centre against the name, and the pair read as ragged.
 * Stretching them to the row height removes the free vertical play entirely.
 * (The guillemet glyphs themselves are not the problem: in Lato their advances
 * differ by one font unit in two thousand.)
 */
.character-selector {
    height: 72px;
    flex-direction: row;
    align-items: stretch;
    margin-bottom: 12px;
    background-color: rgba(20, 24, 27, 0.6);
    border-width: 1px;
    border-color: var(--brass);
    border-radius: 2px;
}

/* Separates the settings block from the action list below it. */
.lobby-actions-rule {
    width: 68%;
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
}

/*
 * Host actions are menu entries, not slabs — the same grammar as the main
 * menu list. Chrome is stripped from the .btn base; hover slides amber,
 * pressed dims, exactly like .menu-entry.
 */
.lobby-action {
    height: auto;
    margin-top: var(--space-3);
    padding: 4px 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--paper-dark);
    font-size: var(--type-lead);
    letter-spacing: 3px;
    -unity-text-align: middle-left;
    transition-property: color, translate;
    transition-duration: 0.10s;
}

.lobby-action:hover {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--amber);
    translate: 8px 0;
}

.lobby-action:active {
    background-color: rgba(0, 0, 0, 0);
    color: var(--amber-dim);
}

/*
 * Start is the loudest line on the sheet, not the biggest box: subtitle size
 * where the other entries are lead. Disabled it fades to graphite — an
 * unavailable action, not a dead grey slab.
 */
.lobby-start {
    height: auto;
    width: 100%;
    margin-top: 0;
    padding: 4px 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--paper-bright);
    font-size: var(--type-subtitle);
    letter-spacing: 3px;
    -unity-text-align: middle-left;
    transition-property: color, translate;
    transition-duration: 0.10s;
}

.lobby-start:hover {
    background-color: rgba(0, 0, 0, 0);
    color: var(--amber);
    translate: 8px 0;
}

.lobby-start:active {
    background-color: rgba(0, 0, 0, 0);
    color: var(--amber-dim);
}

.lobby-start:disabled {
    background-color: rgba(0, 0, 0, 0);
    color: var(--graphite-500);
    border-width: 0;
    opacity: 1;
}

.character-arrow {
    width: 56px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 6px;
    padding-left: 0;
    margin: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    /*
     * The guillemet occupies about a quarter of its em box, so it needs a much
     * larger size than a letter to carry the same weight — at 34px in brass it
     * read as a tick mark rather than a control you can press.
     */
    color: var(--text-hi);
    font-size: 46px;
    -unity-text-align: middle-center;
    transition-property: color, background-color;
    transition-duration: 0.08s;
    transition-timing-function: ease-out;
}

/*
 * The arrows react in colour only. A tinted cell behind them looked broken
 * for two reasons: UI Toolkit leaves :hover latched on the button the pointer
 * clicked, so the block stayed lit after the cursor moved on, and the block
 * spanned the full 56px cell while the guillemet fills a quarter of its em
 * box, so the highlight never looked centred on the glyph it belonged to.
 *
 * Every state is spelled out, including :focus and the :enabled variants.
 * These buttons carry no .btn class, so any state left undeclared falls back
 * to Unity's default .unity-button theme, which paints its own background.
 */
.character-arrow:hover,
.character-arrow:hover:enabled {
    color: var(--amber);
    background-color: rgba(0, 0, 0, 0);
}

.character-arrow:active,
.character-arrow:active:enabled {
    color: var(--amber-dim);
    background-color: rgba(0, 0, 0, 0);
}

.character-arrow:focus,
.character-arrow:focus:enabled {
    background-color: rgba(0, 0, 0, 0);
}

.character-arrow:focus {
    color: var(--amber);
    background-color: rgba(0, 0, 0, 0);
}

.character-arrow:disabled {
    color: var(--graphite-500);
    opacity: 1;
}

.character-name {
    flex-grow: 1;
    font-size: 26px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    color: var(--text-hi);
}

.lobby-toggle { margin-top: 12px; }

.lobby-round-limit-title {
    margin-top: var(--space-2);
    margin-bottom: var(--space-2);
    color: var(--amber);
    font-size: var(--type-kicker);
    letter-spacing: 2px;
}

.lobby-round-limit-options {
    height: auto;
    flex-direction: row;
    margin-bottom: var(--space-2);
}

/*
 * Time limits are type, not chips. The chosen value is underlined in amber
 * the way a detective circles a figure in a report; the rest wait in
 * graphite. All chrome from .btn/.btn--quiet is stripped here.
 */
.lobby-round-limit-button {
    flex-grow: 0;
    height: auto;
    margin: 0 var(--space-6) 0 0;
    padding: 2px 0 6px 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    color: var(--graphite-300);
    font-size: var(--type-body);
    letter-spacing: 2px;
}

.lobby-round-limit-button--last {
    margin-right: 0;
}

.lobby-round-limit-button:hover {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    color: var(--text-hi);
}

.lobby-round-limit-button:active {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    color: var(--amber-dim);
    translate: 0 1px;
}

.lobby-round-limit-button:disabled {
    background-color: rgba(0, 0, 0, 0);
    color: var(--graphite-500);
    opacity: 1;
}

.lobby-round-limit-button--selected,
.lobby-round-limit-button--selected:hover,
.lobby-round-limit-button--selected:disabled {
    color: var(--amber);
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    border-bottom-color: var(--amber);
    opacity: 1;
}

.lobby-toggle-summary,
.lobby-help {
    font-size: 13px;
    color: var(--graphite-300);
    white-space: normal;
    margin-top: 4px;
}

.preview-column {
    flex-grow: 1;
    max-width: 720px;
    height: 82%;
    align-items: center;
    justify-content: flex-end;
    margin-left: 4%;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 24px;
    padding-bottom: 20px;
    background-color: rgba(20, 24, 27, 0.84);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--brass);
    border-right-color: var(--brass);
    border-top-color: var(--brass);
    border-bottom-color: var(--brass);
    border-radius: 2px;
}

.character-preview {
    width: 100%;
    height: 86%;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.preview-caption {
    font-size: 13px;
    color: var(--text-hi);
    background-color: rgba(20, 24, 27, 0.85);
    padding: 8px 16px;
    border-radius: 2px;
    margin-top: 10px;
}

/*
 * The side columns are the main menu's content block twice over: kicker,
 * stamp title, brass rule, then a list of type. No card background — the
 * wash behind them carries the readability.
 */
.lobby-roster-panel,
.lobby-settings-panel {
    position: absolute;
    top: 14%;
    bottom: auto;
    max-height: 78%;
    width: 18%;
    min-width: 340px;
    max-width: 440px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
}

.lobby-roster-panel {
    left: 0;
}

.lobby-settings-panel {
    right: 0;
}

.lobby-side-title {
    font-size: var(--type-title);
    letter-spacing: 3px;
    color: var(--paper-bright);
    white-space: normal;
}

/* Composes Theme's .kicker; only the gap to the title is local. */
.lobby-side-kicker {
    margin-bottom: var(--space-2);
}

.lobby-side-rule {
    width: 68%;
    margin-top: var(--space-3);
    margin-bottom: var(--space-3);
}

.lobby-player-list {
    flex-grow: 1;
    margin-top: 4px;
    margin-bottom: 8px;
}

.lobby-voice-hint {
    color: var(--graphite-300);
    font-size: var(--type-micro);
    letter-spacing: 0.5px;
    -unity-text-align: middle-left;
}

.lobby-player-list .unity-scroll-view__horizontal-scroller,
.lobby-player-list .unity-scroller__low-button,
.lobby-player-list .unity-scroller__high-button {
    display: none;
}

.lobby-player-list .unity-scroll-view__vertical-scroller {
    width: 8px;
    background-color: rgba(0, 0, 0, 0);
}

.lobby-player-list .unity-base-slider__tracker {
    width: 2px;
    background-color: var(--graphite-500);
}

.lobby-player-list .unity-base-slider__dragger {
    width: 6px;
    background-color: var(--brass);
    border-width: 0;
    border-radius: 0;
}

.lobby-player-list-empty {
    margin-top: 24px;
    color: var(--graphite-300);
    font-size: 15px;
    white-space: normal;
}

/*
 * A roster entry is a ledger line, not a card: faint rule below, no fill.
 * The local player is marked by an amber name instead of a highlighted box.
 */
.lobby-player-row {
    min-height: 50px;
    position: relative;
    flex-direction: row;
    align-items: center;
    padding: 6px 0 10px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(76, 83, 89, 0.45);
    background-color: rgba(0, 0, 0, 0);
}

.lobby-player-row--local {
    background-color: rgba(0, 0, 0, 0);
}

.lobby-player-row--local .lobby-player-name {
    color: var(--amber);
}

.lobby-player-row--simulated {
    opacity: 0.68;
}

.lobby-player-number {
    width: 32px;
    color: var(--amber-dim);
    font-size: 13px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/CourierPrime-Regular.ttf");
}

.lobby-player-identity {
    flex-grow: 0;
    flex-shrink: 0;
    width: 208px;
    min-width: 0;
    flex-direction: row;
    align-items: center;
}

.lobby-player-name {
    width: 96px;
    min-width: 96px;
    max-width: 96px;
    color: var(--text-hi);
    font-size: 15px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
}

.lobby-player-host {
    width: 44px;
    min-width: 44px;
    max-width: 44px;
    margin-left: 0;
    color: var(--graphite-300);
    font-size: 12px;
}

.lobby-player-ready {
    width: 68px;
    min-width: 68px;
    max-width: 68px;
    margin-left: 0;
    color: rgb(116, 205, 126);
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    overflow: hidden;
}

.lobby-speaker-indicator {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    margin-left: 24px;
    background-image: url("project://database/Assets/UI/Speaker_Icon.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--amber);
}

.lobby-player-voice-state {
    position: absolute;
    right: 0;
    bottom: 2px;
    color: var(--graphite-300);
    font-size: 8px;
    letter-spacing: 0.5px;
    -unity-font-style: bold;
}

.lobby-start-hover-area {
    position: relative;
    height: auto;
    margin-top: var(--space-2);
}

.lobby-start-hover-info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    margin-bottom: var(--space-2);
    padding: 10px 12px;
    color: var(--text-hi);
    background-color: rgba(20, 24, 27, 0.98);
    font-size: var(--type-micro);
    white-space: normal;
    -unity-text-align: middle-left;
}

.character-selector--legacy {
    display: none;
}

.preview-column {
    position: absolute;
    left: 22%;
    right: 22%;
    top: 0;
    bottom: 0;
    max-width: none;
    height: auto;
    margin: 0;
    padding: 0 24px 16px 24px;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
}

.preview-kicker {
    font-size: 15px;
    color: var(--amber);
    letter-spacing: 3px;
    margin-bottom: 4px;
}

.character-preview {
    height: 72%;
    max-width: 820px;
    translate: 16px 0;
}

/*
 * The selector floats on the art like the menu list does — the brass frame
 * and dark fill of the base .character-selector read as another card here.
 */
.preview-character-selector {
    width: 480px;
    margin-top: 0;
    margin-bottom: var(--space-2);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

/*
 * Gotowy stays a filled button: it is a state you set, not a link you
 * follow, and the green fill is the readiness signal the roster mirrors.
 * Narrower than the selector so it reads as a control, not a slab.
 */
.lobby-ready-button {
    width: 320px;
    height: 48px;
    margin-top: 0;
    margin-bottom: 8px;
}

.lobby-ready-button--active {
    color: rgb(202, 244, 205);
    background-color: rgba(43, 105, 51, 0.88);
    border-left-color: rgb(116, 205, 126);
    border-right-color: rgb(116, 205, 126);
    border-top-color: rgb(116, 205, 126);
    border-bottom-color: rgb(116, 205, 126);
}

.preview-caption {
    margin-top: 0;
    color: var(--graphite-300);
    background-color: rgba(20, 24, 27, 0.68);
}

.paper-shadow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 964px;
    height: 824px;
    translate: -478px -406px;
    background-color: var(--paper-shadow);
}

.paper-document {
    background-color: var(--paper);
    color: var(--ink);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--paper-shadow);
    border-right-color: var(--paper-shadow);
    border-top-color: var(--paper-shadow);
    border-bottom-color: var(--paper-shadow);
    border-radius: 0;
}

.preparation-document {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 960px;
    height: 820px;
    translate: -480px -410px;
    padding: 32px;
}

.document-header,
.preparation-footer,
.private-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.title {
    font-size: 38px;
    letter-spacing: 3px;
}

.preparation-timer {
    width: 112px;
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: var(--ink);
}

.preparation-scroll {
    flex-grow: 1;
    margin-top: 16px;
    margin-bottom: 16px;
}

.preparation-scroll .unity-scroll-view__horizontal-scroller {
    display: none;
}

.preparation-scroll .unity-scroll-view__vertical-scroller {
    width: 10px;
    margin-left: 14px;
    background-color: rgba(0, 0, 0, 0);
}

.preparation-scroll .unity-scroller__low-button,
.preparation-scroll .unity-scroller__high-button {
    display: none;
}

.preparation-scroll .unity-scroller__slider {
    margin-top: 0;
    margin-bottom: 0;
}

.preparation-scroll .unity-base-slider__tracker {
    width: 3px;
    background-color: var(--paper-shadow);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.preparation-scroll .unity-base-slider__dragger {
    width: 8px;
    background-color: var(--brass);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--ink-faded);
    border-right-color: var(--ink-faded);
    border-top-color: var(--ink-faded);
    border-bottom-color: var(--ink-faded);
    border-radius: 0;
}

.preparation-scroll .unity-scroll-view__content-container {
    padding-right: 16px;
}

.preparation-document .document-kicker {
    align-self: flex-start;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
    background-color: var(--brass);
    color: var(--paper-bright);
    font-size: 15px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    opacity: 1;
}

.role-stamp {
    align-self: flex-start;
    font-size: 56px;
    letter-spacing: 3px;
    color: var(--ink);
    opacity: 0.82;
    rotate: -4deg;
    margin-bottom: 16px;
}

.paper-section-title {
    color: var(--ink-faded);
    margin-top: 12px;
}

.body-text,
.alibi,
.preparation-instruction {
    max-width: 640px;
    font-size: 18px;
    white-space: normal;
    color: var(--ink);
    -unity-paragraph-spacing: 8px;
    margin-bottom: 16px;
}

.preparation-instruction {
    margin-top: 16px;
    padding: 16px;
    background-color: var(--paper-bright);
    border-left-width: 3px;
    border-left-color: var(--ink-faded);
}

.preparation-footer {
    border-top-width: 1px;
    border-top-color: var(--paper-shadow);
    padding-top: 16px;
}

.ready-count {
    font-size: 15px;
    color: var(--ink-faded);
}

.ready-button {
    width: 240px;
    height: 52px;
    margin-top: 0;
    padding-left: 24px;
    padding-right: 24px;
    background-color: var(--paper-bright);
    color: var(--ink);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--brass);
    border-right-color: var(--brass);
    border-top-color: var(--brass);
    border-bottom-color: var(--brass);
    border-radius: 0;
    font-size: 18px;
    letter-spacing: 3px;
}

.ready-button:hover {
    background-color: var(--paper-dark);
    color: var(--ink);
    border-left-color: var(--ink-faded);
    border-right-color: var(--ink-faded);
    border-top-color: var(--ink-faded);
    border-bottom-color: var(--ink-faded);
}

.ready-button:active {
    background-color: var(--brass);
    color: var(--paper-bright);
}

.ready-button:focus {
    border-left-color: var(--ink);
    border-right-color: var(--ink);
    border-top-color: var(--ink);
    border-bottom-color: var(--ink);
}

.ready-button:disabled {
    background-color: rgba(0, 0, 0, 0);
    color: var(--green-active);
    border-left-color: var(--green-active);
    border-right-color: var(--green-active);
    border-top-color: var(--green-active);
    border-bottom-color: var(--green-active);
    opacity: 1;
}

.timer {
    position: absolute;
    top: 24px;
    left: 50%;
    translate: -64px 0;
    width: 128px;
    height: 52px;
    padding-top: 8px;
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(20, 24, 27, 0.85);
    border-radius: 2px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--graphite-500);
    border-right-color: var(--graphite-500);
    border-top-color: var(--graphite-500);
    border-bottom-color: var(--graphite-500);
    transition-property: color;
    transition-duration: 0.3s;
}

.timer--critical { color: var(--red); }

.hud-card {
    position: absolute;
    padding: 16px;
    background-color: rgba(20, 24, 27, 0.85);
    border-radius: 2px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--graphite-500);
    border-right-color: var(--graphite-500);
    border-top-color: var(--graphite-500);
    border-bottom-color: var(--graphite-500);
}

.role-card {
    right: 24px;
    bottom: 24px;
    width: 360px;
}

.hud-role,
.private-title {
    font-size: 15px;
    letter-spacing: 2px;
    color: var(--amber);
}

.hud-crime {
    font-size: 13px;
    color: var(--text-hi);
    white-space: normal;
    margin-top: 8px;
}

/*
 * The objective card is bottom-anchored and grows upward to fit the whole
 * current step. No max-height: the full text must always be readable without
 * scrolling or clipping; only the Detective registry keeps a fixed, scrolling
 * area. The fixed width keeps the card on the left edge, so the screen centre
 * stays clear.
 */
.private-card {
    left: 24px;
    bottom: 24px;
    width: 420px;
}

.private-card--registry {
    left: auto;
    right: 24px;
    top: 96px;
    bottom: 184px;
    width: 360px;
    max-height: none;
}

/*
 * Wide enough for a wrapped objective title plus the toggle button. 220px let
 * the title's longest word push the button outside the card border.
 */
.private-card--collapsed {
    width: 324px;
    top: auto;
    bottom: 24px;
}

.private-card--registry.private-card--collapsed {
    right: 24px;
    bottom: 184px;
}

.private-title {
    flex-grow: 1;
    white-space: normal;
    /* Wrap within the available space instead of forcing the row wider than
       the card (the default min-width is the longest word). */
    min-width: 0;
}

.panel-toggle {
    /* Sized by its own label, not fixed: 88px clipped "Rejestr [I]" and
       "Objective [I]" mid-bracket, and the label changes with state and
       language. min-width keeps the three states the same size in practice. */
    width: auto;
    min-width: 88px;
    height: 32px;
    margin-left: 12px;
    /* Never squeezed nor pushed out by a long title. */
    flex-shrink: 0;
    /* .btn pads for a full-size action; this one has to fit a card header. */
    padding: 0 10px;
    font-size: var(--type-micro);
    letter-spacing: 1px;
    white-space: nowrap;
}

.private-content {
    margin-top: 12px;
}
.private-motive,
.private-text,
.private-location,
.private-step {
    white-space: normal;
}
.private-motive { font-size: 13px; color: var(--graphite-300); margin-bottom: 12px; }
.private-step { font-size: 15px; color: var(--text-hi); -unity-font-style: bold; margin-bottom: 8px; }
.private-location { font-size: 15px; color: var(--text-hi); margin-bottom: 8px; }
.private-progress { font-size: 13px; color: var(--amber-dim); margin-bottom: 12px; }
.private-text { font-size: 13px; color: var(--graphite-300); -unity-paragraph-spacing: 6px; }

.result-card {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 840px;
    height: 760px;
    translate: -420px -380px;
    padding: 32px;
}

.result-verdict {
    align-self: flex-start;
    font-size: 56px;
    letter-spacing: 3px;
    color: var(--text-hi);
    rotate: -3deg;
    margin-bottom: 8px;
}

.result-card--loss .result-verdict { color: var(--red); }

.result-reason {
    font-size: 18px;
    color: var(--text-hi);
    white-space: normal;
    margin-bottom: 16px;
}

.result-scroll {
    flex-grow: 1;
    margin-bottom: 8px;
}

.result {
    font-size: 16px;
    color: var(--text-hi);
    white-space: normal;
    -unity-paragraph-spacing: 5px;
}

.result-action {
    align-self: flex-end;
    width: 240px;
}

.toast {
    position: absolute;
    left: 50%;
    top: 24px;
    translate: -280px 0;
    width: 560px;
    padding: 12px 16px;
    font-size: 15px;
    color: var(--text-hi);
    background-color: rgba(20, 24, 27, 0.96);
    border-left-width: 3px;
    border-left-color: var(--amber);
    border-radius: 4px;
    white-space: normal;
}
